# dependencies
node_modules/

# run state (per-repo control plane, never committed here)
#
# `.factory/<run-id>/` is where the factory keeps run.json. It must stay untracked: if it is
# committed, every slice diff carries manifest churn and every merge trips the privileged-path
# refusal, because a slice that edits the control plane is not doing the work it was dispatched for.
# This repository runs the factory on itself, so the rule applies here too.
.factory/
# Run sandboxes. `C = O/.factory-sandboxes` per the feature skill: generated local state, one
# clone per run, removed on completed handoff and retained when a run stops for a human. Root-anchored
# so it hides the container without hiding a same-named directory nested elsewhere.
/.factory-sandboxes/
# Host config and per-repo seeded skills/agents, which are machine-local.
.claude/
.opencode/

# packed tarballs, produced by `npm pack` for local installs
*.tgz

# build / coverage / caches
dist/
coverage/
.cache/

# local env / secrets (never commit)
.env
.env.*
*.pem
*.key

# os / editor
.DS_Store
.idea/
*.iml
*.log

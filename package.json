{
  "name": "opencode-feature-factory",
  "version": "0.1.0",
  "description": "Hybrid opencode plugin and scriptable feature factory workflow.",
  "type": "module",
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./server": "./src/plugin.js",
    "./tui": "./src/tui.jsx",
    "./cli": "./src/cli.js"
  },
  "bin": {
    "feature-factory": "./src/cli.js"
  },
  "files": [
    "assets",
    "src",
    "README.md"
  ],
  "scripts": {
    "doctor": "node src/cli.js doctor",
    "test": "node --test",
    "check": "npm test && node src/cli.js doctor --local"
  },
  "keywords": [
    "opencode",
    "plugin",
    "agent",
    "automation",
    "workflow"
  ],
  "dependencies": {
    "@opentui/solid": "^0.4.3",
    "solid-js": "^1.9.10"
  },
  "license": "MIT"
}

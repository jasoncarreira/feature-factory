{
  "name": "feature-factory-monorepo",
  "private": true,
  "description": "Workspace root. The publishable packages are under packages/ \u2014 this root ships nothing.",
  "type": "module",
  "workspaces": [
    "packages/feature-factory",
    "packages/opencode-feature-factory",
    "packages/prime-agent-feature-factory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasoncarreira/opencode-feature-factory.git"
  },
  "bugs": {
    "url": "https://github.com/jasoncarreira/opencode-feature-factory/issues"
  },
  "homepage": "https://github.com/jasoncarreira/opencode-feature-factory#readme",
  "scripts": {
    "test": "npm run test:packages && npm run test:pack",
    "test:ci": "npm ci && npm test",
    "test:packages": "npm test --workspaces",
    "test:pack": "npm run build --workspace opencode-feature-factory && node --test test/pack.test.js",
    "test:factory": "npm test --workspace feature-factory",
    "test:opencode": "npm test --workspace opencode-feature-factory",
    "test:prime": "npm test --workspace prime-agent-feature-factory",
    "sync:workflows": "node scripts/sync-workflows.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}

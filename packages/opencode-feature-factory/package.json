{
  "name": "opencode-feature-factory",
  "version": "0.5.6",
  "description": "OpenCode integration for feature-factory: server plugin and sidebar. Reads run state; never writes it.",
  "type": "module",
  "license": "MIT",
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./tui": "./tui/dist/index.js"
  },
  "files": [
    "plugin",
    "skills",
    "tui/dist",
    "observe",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "feature-factory": "0.3.6"
  },
  "scripts": {
    "build": "rm -rf tui/dist && esbuild tui/index.jsx --bundle --platform=node --format=esm --jsx=automatic --jsx-import-source=@opentui/solid --packages=external --outfile=tui/dist/index.js",
    "prepack": "npm run sync:workflow && npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "sync:workflow": "node ../../scripts/sync-workflows.js opencode-feature-factory",
    "pretest": "npm run sync:workflow"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "@opentui/solid": "^0.4.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "solid-js": "1.9.12",
    "@opentui/solid": "^0.4.5"
  }
}
